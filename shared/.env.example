# Copy to .env (never commit .env). Ask Saravana for values, or read them from Secret Manager.
GEMINI_API_KEY=
GCP_PROJECT=
AIRA_DEMO_SHOP=sunrise_dairy
AIRA_LIVE_WS=ws://localhost:8080/ws
AIRA_MOCK=1
AIRA_ALLOW_NO_TOKEN=1
# Shared demo key (shared/docs/ops/security.md): hello.idToken must equal it when set. The app builds the same value
# in as VITE_AIRA_APP_KEY. Secret Manager: aira-app-key. Unset locally = no key check.
AIRA_APP_KEY=
VITE_AIRA_APP_KEY=
# Browser origins allowed on /ws and the HTTP API (shared/docs/ops/security.md). Unset = the hosting site + local Vite.
# AIRA_ALLOWED_ORIGINS=https://aira-shop.web.app,http://localhost:5173
FIRESTORE_DATABASE=aira
# Header X-AIRA-Job-Token for the /jobs/* routes (Secret Manager: aira-job-token)
AIRA_JOB_TOKEN=
# Supplier ordering (WhatsApp Business Cloud API test number; Telegram optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
TELEGRAM_TOKEN=
# Also tags the vendor deep links (shared/docs/ops/telegram-setup.md); Secret Manager: aira-telegram-webhook-secret
TELEGRAM_WEBHOOK_SECRET=
# Demo supplier phone numbers (E.164, registered as WhatsApp test recipients)
SUPPLIER_AAVIN_PHONE=
SUPPLIER_SAKTHI_PHONE=
SUPPLIER_ARUN_PHONE=
