# Copy to .env (never commit .env). Ask Saravana for values, or read them from Secret Manager.
GEMINI_API_KEY=
GCP_PROJECT=
AIRA_DEMO_SHOP=sunrise_dairy
AIRA_LIVE_WS=ws://localhost:8080/ws
AIRA_MOCK=1
AIRA_ALLOW_NO_TOKEN=1
# Shared demo key (shared/docs/ops/security.md): hello.idToken must equal it when set. The app builds the same value
# in as VITE_AIRA_APP_KEY. Secret Manager: aira-app-key. Unset locally = no key check.
AIRA_APP_KEY=
VITE_AIRA_APP_KEY=
# Browser origins allowed on /ws and the HTTP API (shared/docs/ops/security.md). Unset = the hosting site + local Vite.
# AIRA_ALLOWED_ORIGINS=https://aira-shop.web.app,http://localhost:5173
# The dashboard's live feed (/monitor), shared/docs/ops/security.md §2a. AIRA_MONITOR_AUTH unset (the default, the
# owner's decision) = the live feed needs no sign-in: anyone who can open the dashboard can watch. 1 = require the
# Google sign-in (Firebase Authentication; the server verifies the ID token, no key) + AIRA_MONITOR_VIEWERS below;
# build the dashboard with VITE_MONITOR_AUTH=1 then.
# AIRA_MONITOR_AUTH=1
# VITE_MONITOR_AUTH=1
# AIRA_MONITOR_VIEWERS (only with AIRA_MONITOR_AUTH=1): comma-separated emails (lowercase) or uid:<Firebase uid>.
# Unset or empty = NOBODY may watch in that mode.
# AIRA_MONITOR_VIEWERS=owner@example.com,uid:AbCdEf0123456789
# AIRA_MONITOR_AUDIO=1: the Live page's Listen button plays the followed session's microphone and AIRA's voice on the
# laptop (shared/docs/ops/live-video.md). Off by default; behind the same access as the feed: without AIRA_MONITOR_AUTH
# anyone who can open the Live page can hear the owner's microphone (security.md §2a). On in production by the owner.
# AIRA_MONITOR_AUDIO=1
# The Firebase project whose ID tokens are accepted (aud / iss). Unset = GCP_PROJECT (the same project today).
# AIRA_FIREBASE_PROJECT=
# Browser origins allowed on /monitor: defence in depth only (a cross-site-WebSocket guard, not authentication; the
# token check is the gate only with AIRA_MONITOR_AUTH=1). Unset = the hosting site only; for local development add the
# Vite hosts (":*" = any port):
# AIRA_MONITOR_ORIGINS=https://aira-shop.web.app,https://aira-shop.firebaseapp.com,http://localhost:*,http://127.0.0.1:*
# Walking guidance (shared/docs/ops/walking-guidance.md). AIRA_WALK=1 turns "walk with me" on; AIRA_ROUTES=1 (with
# AIRA_WALK=1) adds step-by-step routes from the shop map shared/catalog/<shop id>_map.json, or the file named by
# AIRA_ROUTES_MAP. Both off by default; a missing or invalid map leaves routes off.
# AIRA_WALK=1
# AIRA_ROUTES=1
# AIRA_ROUTES_MAP=
# Low light (shared/docs/ops/low-light.md), all off by default. AIRA_TORCH=1: sustained darkness makes AIRA PROPOSE
# the flashlight; the torch command goes to the phone only after the owner's spoken yes. AIRA_LOWLIGHT=1: the
# "where is the light switch" tool (finger guided to a switch, never a socket). The app needs the matching build
# flags: VITE_AIRA_TORCH=1 (report the light level, obey the torch command, report on/off/unsupported) and
# VITE_AIRA_LOWLIGHT=1 (brighten dim uploaded frames; never the bump guard's).
# AIRA_TORCH=1
# AIRA_LOWLIGHT=1
# VITE_AIRA_TORCH=1
# VITE_AIRA_LOWLIGHT=1
FIRESTORE_DATABASE=aira
# Hands-free start (shared/docs/ops/handsfree.md). Build-time app flags, all off unless set to 1 at `npm run build -w app`.
# VITE_AIRA_MEDIA_BUTTON=1     earphone play/pause button talks / stops (web app)
# VITE_AIRA_VOLUME_TRIGGER=1   volume up+down double press (needs the native shell proposal; no effect in the web app)
# VITE_AIRA_WAKEWORD=1         "Hello AIRA" (needs the native shell proposal; no effect in the web app)
# Header X-AIRA-Job-Token for the /jobs/* routes (Secret Manager: aira-job-token)
AIRA_JOB_TOKEN=
# Supplier ordering (WhatsApp Business Cloud API test number; Telegram optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
TELEGRAM_TOKEN=
# Also tags the vendor deep links (shared/docs/ops/telegram-setup.md); Secret Manager: aira-telegram-webhook-secret
TELEGRAM_WEBHOOK_SECRET=
# Demo supplier phone numbers (E.164, registered as WhatsApp test recipients)
SUPPLIER_AAVIN_PHONE=
SUPPLIER_SAKTHI_PHONE=
SUPPLIER_ARUN_PHONE=
