flowchart BT
  subgraph R["Restock: order, delivery, invoice, pay vendor"]
    direction LR
    A["1 Order by voice<br/>read-back + spoken yes<br/>WhatsApp to vendor"] --> B["2 Delivery<br/>live count, one by one or by crate"]
    B --> C["3 Invoice<br/>two independent reads + code check"]
    C -->|match| D["4 Pay vendor<br/>cash slot guided · notes checked<br/>spoken yes"]
    C -->|mismatch| X["DISCREPANCY<br/>spoken + logged"]
    X --> D
    D --> E["5 Remember shelf<br/>this is the Sakthi curd shelf"]
  end
  subgraph S["Sell: customer sale, payment, stock"]
    direction LR
    F["6 Customer sale<br/>hand guided to product<br/>pack verified"] --> G["7 Payment<br/>cash change in code<br/>UPI soundbox matched · spoken yes"]
    G --> H["Stock -2 L exactly once<br/>Firestore transaction"]
    H --> I{"Low stock?<br/>expiry?"}
    I -->|no: next customer| F
    H --> J["8 End of day<br/>spoken summary + suggested order"]
  end
  R ==>|shelves stocked| S
  S -.->|yes: low stock or expiry, reorder| R

  %% Light theme, AIRA brand tokens (build overrides section 6)
  classDef default fill:#F5F8FD,stroke:#1F6FFF,stroke-width:1.5px,color:#0B1F4B
  classDef danger fill:#FEF2F2,stroke:#DC2626,stroke-width:2px,color:#0B1F4B
  classDef ok fill:#F0FDF4,stroke:#16A34A,stroke-width:2px,color:#0B1F4B
  classDef warn fill:#FFF7ED,stroke:#FF8A3D,stroke-width:2px,color:#0B1F4B
  class X danger
  class H ok
  class I warn
  style R fill:#FFFFFF,stroke:#E3E9F4,stroke-width:2px,color:#0B1F4B
  style S fill:#FFFFFF,stroke:#E3E9F4,stroke-width:2px,color:#0B1F4B
  linkStyle default stroke:#4A5A7A,stroke-width:1.5px
